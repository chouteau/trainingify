@page "/"
@using Velodromify.Data

<PageTitle>Velodromify</PageTitle>

@if (currentUser == null)
{
    <Login OnUserLoggedIn="HandleUserLoggedIn" />
}
else
{
    <Velodrome CurrentUser="currentUser" />
}

@code {
    private User? currentUser;

    private void HandleUserLoggedIn(User user)
    {
        currentUser = user;
        StateHasChanged();
    }
}

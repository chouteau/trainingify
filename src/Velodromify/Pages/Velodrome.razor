@using Velodromify.Services
@using Velodromify.Data
@inject RaceService RaceService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="velodrome-container" style="position: relative; width: 800px; height: 400px; background-color: #333; margin: 0 auto; border-radius: 200px;">
    <!-- Track Markings -->
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 600px; height: 200px; border: 2px dashed #555; border-radius: 100px;"></div>
    
    <!-- Riders -->
    @foreach (var rider in Riders)
    {
        <div class="rider" style="position: absolute; 
             left: @(rider.X)px; 
             top: @(rider.Y)px; 
             transform: translate(-50%, -50%) rotate(@(rider.Rotation)rad);
             transition: all 0.1s linear;">
            <div style="width: 20px; height: 10px; background-color: @(rider.User.Pseudo == CurrentUser?.Pseudo ? "yellow" : "cyan"); border-radius: 5px;"></div>
            <div style="position: absolute; top: -20px; left: 50%; transform: translateX(-50%); color: white; font-size: 12px; white-space: nowrap;">
                @rider.User.Pseudo
            </div>
        </div>
    }
</div>

<div class="mt-3 text-center text-white">
    @if (CurrentUser != null)
    {
        var myStats = Riders.FirstOrDefault(r => r.User.Id == CurrentUser.Id);
        if (myStats != null)
        {
            <div>Speed: @myStats.SpeedKmh.ToString("F1") km/h | Power: @myStats.PowerWatts W | Dist: @myStats.TotalDistance.ToString("F0") m</div>
        }
    }
    
    <div class="mt-2">
        @if (!IsConnected)
        {
            <button class="btn btn-primary" @onclick="ConnectBluetooth">Connect Trainer (Bluetooth)</button>
        }
        else
        {
            <span class="text-success">Trainer Connected</span>
        }
        
        <button class="btn btn-secondary ms-2" @onclick="SimulateData">Simulate (Test)</button>
    </div>
</div>

@code {
    [Parameter]
    public User? CurrentUser { get; set; }

    private IEnumerable<RiderState> Riders => RaceService.GetRiders();
    private BluetoothInterop? _bleInterop;
    private bool IsConnected = false;
    private System.Threading.Timer? _simulationTimer;

    protected override void OnInitialized()
    {
        RaceService.OnStateChanged += HandleStateChanged;
        if (CurrentUser != null)
        {
            RaceService.RegisterRider(CurrentUser);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _bleInterop = new BluetoothInterop(JSRuntime);
            _bleInterop.OnDataReceived += HandleBleData;
            await _bleInterop.InitializeAsync();
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ConnectBluetooth()
    {
        if (_bleInterop != null)
        {
            IsConnected = await _bleInterop.ConnectAsync();
        }
    }

    private void HandleBleData(double speed, double power, double cadence)
    {
        if (CurrentUser != null)
        {
            // Calculate delta time (simplified, assuming regular updates or using timestamp)
            // For now, let's assume updates come every 1 second or calculate based on last update.
            // Actually, RaceService calculates distance based on speed and delta.
            // We should track time here.
            
            // Better: Send data to RaceService, let it handle time tracking if needed, 
            // but RaceService needs delta.
            // Let's estimate delta as time since last call.
            
            double delta = 1.0; // Default 1s if we don't track.
            // TODO: Track real delta.
            
            RaceService.UpdateRiderProgress(CurrentUser.Id, speed, power, 0, delta);
        }
    }
    
    // Simulation
    private void SimulateData()
    {
        if (_simulationTimer == null)
        {
            _simulationTimer = new System.Threading.Timer(TickSimulation, null, 0, 1000);
        }
        else
        {
            _simulationTimer.Dispose();
            _simulationTimer = null;
        }
    }
    
    private void TickSimulation(object? state)
    {
        if (CurrentUser != null)
        {
            // Random speed between 20 and 40 km/h
            var rnd = new Random();
            double speed = 20 + rnd.NextDouble() * 20;
            double power = 100 + rnd.NextDouble() * 200;
            
            RaceService.UpdateRiderProgress(CurrentUser.Id, speed, power, 0, 1.0);
        }
    }

    public void Dispose()
    {
        RaceService.OnStateChanged -= HandleStateChanged;
        _bleInterop?.DisposeAsync();
        _simulationTimer?.Dispose();
    }
}

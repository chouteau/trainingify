@page "/login"
@using Velodromify.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>Join the Race</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@user" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="pseudo" class="form-label">Pseudo</label>
                            <InputText id="pseudo" class="form-control" @bind-Value="user.Pseudo" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Start Riding</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private User user = new();

    [Parameter]
    public EventCallback<User> OnUserLoggedIn { get; set; }

    private async Task HandleLogin()
    {
        // Check if user exists or create new
        var existingUser = await DbContext.Users.FirstOrDefaultAsync(u => u.Pseudo == user.Pseudo);
        if (existingUser == null)
        {
            DbContext.Users.Add(user);
            await DbContext.SaveChangesAsync();
            await OnUserLoggedIn.InvokeAsync(user);
        }
        else
        {
            await OnUserLoggedIn.InvokeAsync(existingUser);
        }
    }
}

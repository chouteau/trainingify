@page "/"
@using Microsoft.EntityFrameworkCore
@using Trainingify.Data
@inject IDbContextFactory<TrainingifyDbContext> DbFactory
@inject Trainingify.Services.TrainingStateService StateService
@inject NavigationManager Navigation

<PageTitle>Trainingify - Tableau de bord</PageTitle>

<section class="home-dashboard">
    <header class="home-topbar">
        <div class="brand-lockup">
            <img src="images/trainingify-logo.svg" alt="Logo Trainingify" />
            <div><strong>TRAININGIFY</strong><span>Ride stronger</span></div>
        </div>
        <div class="home-device-state">
            <span class="home-status-dot @(StateService.ControllableConnected ? "connected" : null)"></span>
            @(StateService.ControllableConnected ? "Home trainer connecté" : "Prêt à rouler")
        </div>
    </header>

    <div class="home-hero">
        <img class="home-hero-image" src="images/indoor-cycling-hero.png" alt="Cycliste en plein effort sur un home trainer, face à un ventilateur" />
        <div class="home-hero-shade"></div>
        <div class="home-hero-content">
            <span class="home-eyebrow">VOTRE PROGRESSION</span>
            <h1>Chaque coup de pédale<br />vous rend plus fort.</h1>
            <p>@GetHeroMessage()</p>
            <button class="home-primary-action" @onclick='() => Navigation.NavigateTo("/workouts")'>
                <i class="bi bi-play-fill"></i> Démarrer un workout
            </button>
        </div>
    </div>

    <div class="home-kpi-grid">
        <article class="home-kpi featured">
            <span class="home-kpi-icon"><i class="bi bi-lightning-charge-fill"></i></span>
            <div><strong>@WorkoutCount</strong><span>Workouts effectués</span></div>
            <small>Depuis vos débuts</small>
        </article>
        <article class="home-kpi">
            <span class="home-kpi-icon orange"><i class="bi bi-fire"></i></span>
            <div><strong>@FormatNumber(TotalCalories)</strong><span>Calories brûlées</span></div>
            <small>Estimation cumulée</small>
        </article>
        <article class="home-kpi">
            <span class="home-kpi-icon cyan"><i class="bi bi-stopwatch-fill"></i></span>
            <div><strong>@FormatDuration(TotalDurationSeconds)</strong><span>Temps d'entraînement</span></div>
            <small>Temps total en selle</small>
        </article>
        <article class="home-kpi">
            <span class="home-kpi-icon green"><i class="bi bi-speedometer2"></i></span>
            <div><strong>@(BestPower > 0 ? $"{BestPower:F0} W" : "—")</strong><span>Puissance maximale</span></div>
            <small>Votre meilleur effort</small>
        </article>
        <article class="home-kpi">
            <span class="home-kpi-icon purple"><i class="bi bi-activity"></i></span>
            <div><strong>@(TotalTss > 0 ? TotalTss.ToString("F0") : "—")</strong><span>TSS cumulé</span></div>
            <small>Charge des séances effectuées</small>
        </article>
    </div>

    <div class="home-footer-stats">
        <div><span>PUISSANCE MOYENNE</span><strong>@(AveragePower > 0 ? $"{AveragePower:F0} W" : "—")</strong></div>
        <div><span>DERNIÈRE SÉANCE</span><strong>@(LastWorkoutDate?.ToString("dd MMM") ?? "—")</strong></div>
        <div><span>FTP ACTUELLE</span><strong>@StateService.Profile.Ftp.ToString("F0") W</strong></div>
    </div>
</section>

@code {
    private int WorkoutCount;
    private double TotalCalories;
    private double TotalDurationSeconds;
    private double BestPower;
    private double AveragePower;
    private double TotalTss;
    private DateTime? LastWorkoutDate;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var sessions = await db.CompletedSessions.AsNoTracking().ToListAsync();
        WorkoutCount = sessions.Count;
        TotalDurationSeconds = sessions.Sum(s => s.DurationSeconds);
        TotalCalories = sessions.Sum(s => s.AveragePower * s.DurationSeconds / 1000d);
        BestPower = sessions.Count == 0 ? 0 : sessions.Max(s => s.MaxPower);
        AveragePower = sessions.Count == 0 ? 0 : sessions.Average(s => s.AveragePower);
        TotalTss = sessions.Sum(CalculateTss);
        LastWorkoutDate = sessions.OrderByDescending(s => s.Date).Select(s => (DateTime?)s.Date).FirstOrDefault();
    }

    private double CalculateTss(CompletedSession session)
    {
        var ftp = session.FtpAtCompletion > 0 ? session.FtpAtCompletion : StateService.Profile.Ftp;
        var normalizedPower = session.NormalizedPower > 0 ? session.NormalizedPower : session.AveragePower;
        if (ftp <= 0 || session.DurationSeconds <= 0 || normalizedPower <= 0)
        {
            return 0;
        }

        var intensityFactor = normalizedPower / ftp;
        return session.DurationSeconds * normalizedPower * intensityFactor / (ftp * 3600d) * 100d;
    }

    private string GetHeroMessage() => WorkoutCount switch
    {
        0 => "Votre prochaine progression commence ici.",
        1 => "Votre première séance est dans les jambes. Continuez !",
        _ => $"Déjà {WorkoutCount} séances accomplies. La prochaine vous attend."
    };

    private static string FormatNumber(double value) => Math.Round(value).ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));

    private static string FormatDuration(double seconds)
    {
        var duration = TimeSpan.FromSeconds(seconds);
        return duration.TotalHours >= 1 ? $"{(int)duration.TotalHours} h {duration.Minutes:D2}" : $"{duration.Minutes} min";
    }
}

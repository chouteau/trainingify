@page "/{markdownpath:nonfile?}"
@using Markdig
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Web

@inject IWebHostEnvironment Env

@code {
	[CascadingParameter]
	public HttpContext HttpContext { get; set; } = default!;

	[Parameter]
	public string MarkdownPath { get; set; } = null!;

	MarkupString htmlContent = default!;
	string? content = default!;
	string? title = default!;

	protected override async Task OnInitializedAsync()
	{
		var mdfile = Path.Combine(Env.WebRootPath, $"{MarkdownPath}.md");
		
		if (!System.IO.File.Exists(mdfile))
		{
			content = @"
# 404 – Page non trouvée

Oups… La page que vous cherchez n’existe pas ou a été déplacée.

---

[Retour à l’accueil](/)

## Quelques options :

- Vérifiez l’URL si vous l’avez saisie à la main
- Utilisez le menu pour naviguer vers une autre section
- [Contactez-nous](/contact) si vous avez besoin d’aide

---

> _On avance, même dans l’inconnu. Continuez votre visite !_
";
			HttpContext.Response.StatusCode = 404;
		}
		else
		{
			content = await System.IO.File.ReadAllTextAsync(mdfile);
		}

		var markDownBuilder = new MarkdownPipelineBuilder()
			.UseAdvancedExtensions()
			.UseBootstrap()
			.UseEmojiAndSmiley()
			.UseMediaLinks()
			.Build();

		var html = Markdown.ToHtml(content, markDownBuilder);
		html = Regex.Replace(html, @"^<p>|</p>$", string.Empty);
		html = html.Replace("\n", "");

		htmlContent = new MarkupString(html);

		// On récupère la première ligne comme titre
		var lines = content.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries);
		var title = lines.FirstOrDefault()?.Trim();
		// on nettoie tous les caractères de début et de fin de ligne avec #
		if (title is not null)
		{
			title = title.Replace("#", "").Trim();
		}
	}
}

<HeadContent>
</HeadContent>

@if (content is not null)
{
	<PageTitle>@title - Trainingify</PageTitle>
}

<main class="content-wrapper">
	<div class="container py-5 mb-2 mt-n2 mt-sm-1 my-md-3 my-lg-4 mb-xl-5">
		<div class="row justify-content-center">
			<div class="col-lg-11 col-xl-10 col-xxl-9">
				@if (content is null)
				{
					<span>Chargement...</span>
				}
				else
				{
					@htmlContent
				}
			</div>
		</div>
	</div>
</main>
@page "/login"
@inject NavigationManager Navigation

@code {

    private void RedirectToGarmin()
    {
        // À générer dynamiquement côté C#
        var clientId = "VOTRE_CLIENT_ID_GARMIN";
        var redirectUri = "https://trainingify.com/garmin-callback";
        // var codeVerifier = GenerateCodeVerifier(); // Fonction utilitaire à implémenter
        // var codeChallenge = GenerateCodeChallenge(codeVerifier); // Fonction utilitaire à implémenter
        var codeChallenge = "";

        // Stocker temporairement le codeVerifier côté serveur/session

        var url =
            $"https://connect.garmin.com/oauth2Confirm?" +
            $"client_id={clientId}&response_type=code" +
            $"&redirect_uri={Uri.EscapeDataString(redirectUri)}" +
            $"&code_challenge={codeChallenge}" +
            $"&code_challenge_method=S256";
        Navigation.NavigateTo(url, true);
    }
}

<div class="auth-container">
    <h2>Authentification Garmin</h2>
    <p>
        Pour connecter votre compte Garmin et importer ou exporter vos données d'entraînement,
        cliquez sur le bouton ci-dessous. Vous serez redirigé·e vers Garmin Connect pour accorder les autorisations nécessaires.
    </p>
    <button class="btn btn-primary" @onclick="RedirectToGarmin">
        <img src="/img/garmin.svg" alt="Garmin" style="height: 1.5em; margin-right: 0.5em;" />
        Se connecter avec Garmin
    </button>
</div>
